# Quantum Infoway — clean URL routing (Apache)
# /about-us → about-us.php, /services/ai-development → services/ai-development.php

# Prevent directory listings (hire/ and services/ collide with hire.php / services.php)
Options -Indexes

# Render missing URLs without redirecting or changing their 404 status.
ErrorDocument 404 /404.php

# Stop /hire ↔ /hire/ redirect loops (directory hire/ exists alongside hire.php)
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prefer root .php pages over same-named directories (internal only — no 301)
    # [END] prevents further rewrite passes that could re-trigger DirectorySlash
    RewriteRule ^(hire|services)/?$ $1.php [END]

    # Keep real files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect /index.php → /
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Redirect /path/to/page.php → /path/to/page (keep query string)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Internally map extensionless URLs to .php when the file exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Deny access to sensitive paths (defense in depth; also covered by .gitignore)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
