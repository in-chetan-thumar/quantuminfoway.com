# Application
APP_URL=https://quantuminfoway.com

# MySQL — OSPanel often binds MariaDB/MySQL to 127.0.1.17
DB_CONNECTION=mysql
DB_HOST=127.0.1.17
DB_PORT=3306
DB_DATABASE=test_quantuminfoway
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP (Gmail: enable 2FA, then create an App Password — not your normal login password)
# SMTP_FROM should match the same account as SMTP_USER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME="Quantum Infoway Website"
SMTP_TO=info@quantuminfoway.com
